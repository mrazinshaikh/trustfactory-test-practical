{
    "preset": "laravel",
    "rules": {
        "concat_space": {
            "spacing": "one"
        },
        "ordered_imports": {
            "sort_algorithm": "length",
            "imports_order": [
                "const",
                "class",
                "function"
            ]
        },
        "braces": {
            "allow_single_line_anonymous_class_with_empty_body": false
        },
        "single_import_per_statement": {
            "group_to_single_imports": false
        },
        "binary_operator_spaces": {
            "default": "align_single_space_minimal"
        }
    },
    "exclude": [
        "vendor/"
    ]
}